{
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "lib": ["ES2021", "dom", "dom.iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ES2022",
    "types": ["node"],
    "verbatimModuleSyntax": false
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*"]
}
